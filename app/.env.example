# ---------------------------------------------------------------------------
# Database — TWO ROLES, and the distinction is load-bearing.
#
# The migrator owns the tables. The application role does not, and must not:
# a superuser or table owner bypasses Row-Level Security even with FORCE set,
# which silently disables tenant isolation with no error and no failing query.
# See src/db/rls.ts and PRODUCT-PLAN.md §4.2.
# ---------------------------------------------------------------------------
POSTGRES_DB=coldpath
POSTGRES_MIGRATOR_USER=coldpath_migrator
POSTGRES_MIGRATOR_PASSWORD=change-me
POSTGRES_PORT=5432

# Migrator connection — used only by scripts/migrate-prod.ts
DATABASE_URL=postgres://coldpath_migrator:change-me@db:5432/coldpath

# Application connection — must be a NON-superuser that does NOT own the tables.
# Every request runs as this role inside a transaction that sets app.tenant_id.
APP_DATABASE_URL=postgres://coldpath_app:change-me@db:5432/coldpath

COLDPATH_MIGRATIONS_DIR=./src/db/migrations

# ---------------------------------------------------------------------------
# LLM — provider-agnostic (PRODUCT-PLAN.md decision #5). Default Anthropic.
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic          # anthropic | openai | azure_openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
LLM_MODEL_CLASSIFY=             # cheap model for classification stages
LLM_MODEL_SYNTHESISE=           # strongest available for pain mapping + writing

# ---------------------------------------------------------------------------
# Identity — OIDC against Ndustrial's existing IdP (AUTH-SPEC.md §4.1).
# No password storage, no reset flow, no MFA implementation.
# ---------------------------------------------------------------------------
OIDC_ISSUER=                    # e.g. https://accounts.google.com or the Entra tenant URL
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_GROUP_CLAIM=groups         # Entra ID: groups | Cognito: cognito:groups | Okta: groups

# Directory group → COLDPATH role mapping (AUTH-SPEC.md §6), as GROUP=role
# pairs. A user whose groups match nothing gets ZERO roles and is refused at
# sign-in — there is no default role, by design. Group-derived grants are
# re-synced at every sign-in; hand-granted roles (granted_by set) are never
# touched by the sync.
COLDPATH_GROUP_ROLES=COLDPATH-Admins=admin,COLDPATH-Marketing=marketing,COLDPATH-Leads=sales_lead,COLDPATH-Reps=rep

# NOTE: there is deliberately no OIDC_ALLOW_INSECURE. The http://-issuer mode
# (IdpConfig.allowInsecure) is a code-level flag used only by the test suite's
# mock IdP; exposing it as an environment variable would let a misconfigured
# deployment downgrade token transport security without a code review.

SESSION_COOKIE_NAME=coldpath_session
SESSION_HOURS=8
REFRESH_DAYS=30

# ---------------------------------------------------------------------------
# Connectors
# ---------------------------------------------------------------------------
RMP_API_BASE=https://rmpmap.org/api
RMP_RATE_LIMIT_PER_SEC=3        # API terms request <=10; we stay well under
SALESINTEL_API_KEY=             # absent until a contract exists (INGESTION-GATES.md §5)

LOG_LEVEL=info
NODE_ENV=development
